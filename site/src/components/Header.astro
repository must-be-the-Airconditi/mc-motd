---
import type { Lang } from '../i18n';
import { t } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const other = lang === 'en' ? '/' : '/en/';
import { BASE as base } from '../base';
---
<header class="app-bar">
  <a class="brand" href={base}>
    <img src={`${base}/assets/icon.svg`} alt="" width="28" height="28" />
    <span>{tr('brand')}</span>
  </a>
  <nav class="nav">
    <a href="#features">{tr('nav.features')}</a>
    <a href="#shots">{tr('nav.shots')}</a>
    <a href="#install">{tr('nav.install')}</a>
    <a href="https://github.com/must-be-the-Airconditi/mc-motd">{tr('nav.source')}</a>
  </nav>
  <div class="actions">
    <button id="theme" class="icon-btn" title="Theme">☾</button>
    <a class="text-btn" href={`${base}${other.replace(/^\//, '')}`} style="display:inline-flex;align-items:center;text-decoration:none">
      {lang === 'en' ? '中文' : 'EN'}
    </a>
  </div>
</header>
<script>
  (function () {
    var btn = document.getElementById('theme');
    var themes = ['mocha', 'latte'];
    function paint() {
      var t = document.documentElement.dataset.theme === 'mocha' ? 'mocha' : 'latte';
      // 图标表示「点一下会切到哪」：深色→显示太阳，浅色→显示月亮
      btn.textContent = t === 'mocha' ? '☀' : '☾';
      btn.title = t === 'mocha' ? '切换到浅色 Latte' : '切换到深色 Mocha';
      btn.setAttribute('aria-label', btn.title);
    }
    paint();
    btn.addEventListener('click', function () {
      var next = themes[(themes.indexOf(document.documentElement.dataset.theme) + 1) % themes.length];
      var root = document.documentElement;
      var r = btn.getBoundingClientRect();
      root.style.setProperty('--tx', (r.left + r.width / 2) + 'px');
      root.style.setProperty('--ty', (r.top + r.height / 2) + 'px');
      root.classList.add('switching');
      setTimeout(function () { root.classList.remove('switching'); }, 360);
      function apply() {
        root.dataset.theme = next;
        localStorage.setItem('site:theme', next);
        paint();
      }
      if (document.startViewTransition) {
        root.classList.add('vt');
        document.startViewTransition(apply).finished.finally(function () { root.classList.remove('vt'); });
      } else apply();
    });
  })();
</script>
